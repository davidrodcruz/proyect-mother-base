---
import Badge from '../atoms/Badge.astro';

interface Props {
  company: string;
  role: string;
  period: { start: string; end: string | null };
  responsibilities: string[];
  technologies: string[];
  achievements: string[];
  index: number;
}

const { company, role, period, responsibilities, technologies, achievements, index } = Astro.props;

// Zigzag: even entries hug the left (line runs down the left edge), odd hug
// the right. Each row draws its own segment of the snake: vertical down the
// card edge + horizontal across the gap, with a rounded elbow. Together the
// segments form one continuous path that wraps the whole experience.
const isLeft = index % 2 === 0;

function formatDate(dateStr: string | null | undefined) {
  if (!dateStr || dateStr === 'present') return 'Present';
  // Normalize "YYYY-MM" to the first of the month so it doesn't roll back
  // a month across timezone boundaries when parsed as UTC.
  const normalized = /^(\d{4}-\d{2})$/.test(dateStr) ? `${dateStr}-01` : dateStr;
  const date = new Date(normalized);
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<div class={`stair-row ${isLeft ? 'stair-left' : 'stair-right'}`}>
  <div class="stair-dot" />

  <div class="stair-card">
    <div class="bg-card backdrop-blur-sm rounded-lg hud-border p-6 hover:shadow-[0_0_15px_rgba(147,198,208,0.15)] transition-all">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-headline text-sm tracking-[0.2em] uppercase font-heading text-shadow-glow">
          {formatDate(period.start)} — {formatDate(period.end)}
        </span>
      </div>

      <h3 class="font-heading text-2xl font-bold text-headline mb-1">{role}</h3>
      <p class="text-body text-base mb-4">{company}</p>

      {responsibilities.length > 0 && (
        <div class="mb-4">
          <h4 class="text-headline text-sm tracking-wider uppercase mb-2 font-heading text-shadow-glow">Responsibilities</h4>
          <ul class="space-y-1.5">
            {responsibilities.map((resp: string) => (
              <li class="text-body text-base flex items-start gap-2">
                <span class="text-border mt-1">▸</span>
                <span>{resp}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {achievements.length > 0 && (
        <div class="mb-4">
          <h4 class="text-headline text-sm tracking-wider uppercase mb-2 font-heading text-shadow-glow">Key Achievements</h4>
          <ul class="space-y-1.5">
            {achievements.map((achievement: string) => (
              <li class="text-body text-base flex items-start gap-2">
                <span class="text-accent mt-1">★</span>
                <span>{achievement}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="flex flex-wrap gap-1.5">
        {technologies.map((tech: string) => (
          <Badge text={tech} variant="accent" size="sm" />
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .stair-row {
    position: relative;
    /* padding-top == margin-bottom keeps the horizontal connector perfectly
       centered between consecutive cards */
    padding-top: 28px;
    margin-bottom: 28px;
  }
  .stair-row:last-child {
    margin-bottom: 0;
  }

  /* The snake lives in a gutter OUTSIDE the card (G = 18px of clearance)
     while the card takes the full row width. */
  .stair-card {
    width: 100%;
  }

  /* Snake segment: one path = vertical down the gutter beside the card +
     horizontal across the gap to the opposite gutter, rounded elbow. */
  .stair-row::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -28px;
    width: calc(100% + 36px);
    border-color: rgba(147, 198, 208, 0.4);
    border-width: 2px;
    border-style: solid;
  }
  .stair-left::before {
    left: -18px;
    border-right: none;
    border-top: none;
    border-bottom-left-radius: 20px;
  }
  .stair-right::before {
    right: -18px;
    border-left: none;
    border-top: none;
    border-bottom-right-radius: 20px;
  }

  /* Last entry: no horizontal crossing — the path just ends with a terminal dot. */
  .stair-row:last-child::before {
    bottom: -14px;
    border-bottom: none;
    border-radius: 0;
  }
  .stair-row:last-child::after {
    content: "";
    position: absolute;
    bottom: -19px;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: rgba(147, 198, 208, 0.7);
  }
  .stair-left:last-child::after {
    left: -21px;
  }
  .stair-right:last-child::after {
    right: -21px;
  }

  /* Node dot centered on the gutter line at each entry's elbow. */
  .stair-dot {
    position: absolute;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: #93C6D0;
    box-shadow: 0 0 10px rgba(147, 198, 208, 0.6);
    z-index: 10;
  }
  .stair-left .stair-dot {
    left: -23px;
  }
  .stair-right .stair-dot {
    right: -23px;
  }

  @media (max-width: 640px) {
    .stair-row::before {
      width: calc(100% + 24px);
    }
    .stair-left::before {
      left: -12px;
    }
    .stair-right::before {
      right: -12px;
    }
    .stair-left .stair-dot {
      left: -17px;
    }
    .stair-right .stair-dot {
      right: -17px;
    }
  }
</style>
